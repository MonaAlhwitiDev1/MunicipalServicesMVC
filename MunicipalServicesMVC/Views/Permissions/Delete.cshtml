@model MunicipalServicesMVC.Domain.Models.Permission

@{
    ViewData["Title"] = "حذف الصلاحية";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="mb-4">
        <h2 class="fw-bold mb-0"
            style="color:var(--main-green-dark);">
            حذف الصلاحية
        </h2>
    </div>

    <!-- بطاقة حذف الصلاحية -->
    <div class="card border-0 shadow-sm w-100">

        <!-- رأس البطاقة -->
        <div class="card-header bg-success text-white py-3">
            <h5 class="fw-bold mb-0">
                بيانات الصلاحية
            </h5>
        </div>

        <div class="card-body p-4">

            <!-- رسالة تأكيد الحذف -->
            <div class="alert alert-danger mb-4"
                 role="alert">
                <strong>
                    هل أنت متأكد من حذف هذه الصلاحية؟
                </strong>
            </div>

            <!-- اسم الصلاحية -->
            <div class="mb-4">

                <label class="form-label fw-bold">
                    اسم الصلاحية
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.Name"
                       readonly />

            </div>

            <!-- وصف الصلاحية -->
            <div class="mb-4">

                <label class="form-label fw-bold">
                    الوصف
                </label>

                <textarea class="form-control"
                          rows="4"
                          readonly>@Model.Description</textarea>

            </div>

            <!-- نموذج الحذف -->
            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <!-- رقم الصلاحية -->
                <input type="hidden" asp-for="Id" />

                <!-- أزرار العمليات -->
                <div class="d-flex flex-wrap justify-content-end gap-2 pt-3 border-top">

                    <!-- زر الرجوع -->
                    <a asp-action="Index"
                       class="btn btn-warning px-4">
                        رجوع
                    </a>

                    <!-- زر الحذف -->
                    <button type="submit"
                            class="btn btn-danger px-4">
                        تأكيد الحذف
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>