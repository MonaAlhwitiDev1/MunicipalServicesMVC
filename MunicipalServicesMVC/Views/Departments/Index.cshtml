@model IEnumerable<MunicipalServicesMVC.Domain.Models.Department>

@{
    ViewData["Title"] = "الإدارات";

    var departments = Model?.ToList()
        ?? new List<MunicipalServicesMVC.Domain.Models.Department>();
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة وزر الإضافة -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <h2 class="fw-bold mb-0"
            style="color:var(--main-green-dark);">
            إدارة الإدارات
        </h2>

        <a asp-action="Create"
           class="btn btn-warning px-4 py-2">
            + إضافة إدارة جديدة
        </a>

    </div>

    <!-- بطاقة إجمالي الإدارات -->
    <div class="row mb-4">

        <div class="col-md-4 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2">
                                إجمالي الإدارات
                            </p>

                            <h2 class="fw-bold text-success mb-0">
                                @departments.Count
                            </h2>
                        </div>

                        <div class="fs-2">
                            🏢
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- بطاقة جدول الإدارات -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-success text-white py-3">

            <h5 class="fw-bold mb-0">
                قائمة الإدارات
            </h5>

        </div>

        <div class="card-body p-3">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle text-center mb-0"
                       style="width:100%; table-layout:auto;">

                    <thead class="table-success">

                        <tr>
                            <th class="bg-success text-white py-3 text-center">
                                الرقم
                            </th>

                            <th class="bg-success text-white py-3 text-center">
                                اسم الإدارة
                            </th>

                            <th class="bg-success text-white py-3 text-center">
                                عدد الموظفين
                            </th>

                            <th class="bg-success text-white py-3 text-center">
                                عدد الخدمات
                            </th>

                            <th class="bg-success text-white py-3 text-center"
                                style="min-width:190px;">
                                الإجراءات
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (departments.Any())
                        {
                            @foreach (var department in departments)
                            {
                                <tr>

                                    <!-- رقم الإدارة -->
                                    <td class="py-3 fw-semibold">
                                        @department.Id
                                    </td>

                                    <!-- اسم الإدارة -->
                                    <td class="py-3">
                                        @department.Name
                                    </td>

                                    <!-- عدد الموظفين -->
                                    <td class="py-3">

                                        <span class="badge bg-light text-success border px-3 py-2">
                                            @(department.Employees?.Count ?? 0)
                                        </span>

                                    </td>

                                    <!-- عدد الخدمات -->
                                    <td class="py-3">

                                        <span class="badge bg-light text-success border px-3 py-2">
                                            @(department.Services?.Count ?? 0)
                                        </span>

                                    </td>

                                    <!-- أزرار الإجراءات -->
                                    <td class="py-3">

                                        <div class="d-flex flex-nowrap justify-content-center align-items-center gap-2">

                                            <a asp-action="Edit"
                                               asp-route-uid="@department.UID"
                                               class="btn btn-warning btn-sm px-3">
                                                تعديل
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-uid="@department.UID"
                                               class="btn btn-danger btn-sm px-3">
                                                حذف
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-5">
                                    لا توجد إدارات مسجلة حاليًا.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>