@model MunicipalServicesMVC.Domain.Models.User

@{
    ViewData["Title"] = "حذف المستخدم";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="mb-4">

        <h2 class="fw-bold mb-0"
            style="color:var(--main-green-dark);">
            حذف المستخدم
        </h2>

    </div>

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9 col-md-11">

            <div class="card border-0 shadow-sm">

                <!-- عنوان البطاقة -->
                <div class="card-header bg-success text-white py-3">

                    <h5 class="fw-bold mb-0">
                        بيانات المستخدم
                    </h5>

                </div>

                <div class="card-body p-4">

                    <!-- رسالة تأكيد الحذف -->
                    <div class="alert alert-danger text-center mb-4">

                        هل أنت متأكد من حذف هذا المستخدم؟

                    </div>

                    <!-- اسم المستخدم -->
                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            اسم المستخدم
                        </label>

                        <input type="text"
                               value="@Model.Name"
                               class="form-control"
                               readonly />

                    </div>

                    <!-- البريد الإلكتروني -->
                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            البريد الإلكتروني
                        </label>

                        <input type="text"
                               value="@Model.Email"
                               class="form-control"
                               readonly />

                    </div>

                    <!-- الدور -->
                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            الدور
                        </label>

                        <input type="text"
                               value="@(Model.Role?.Name ?? "غير محدد")"
                               class="form-control"
                               readonly />

                    </div>

                    <!-- نموذج الحذف -->
                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <!-- أزرار الإجراءات -->
                        <div class="d-flex flex-wrap justify-content-end gap-2 pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-warning px-4">
                                رجوع
                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4">
                                حذف المستخدم
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>