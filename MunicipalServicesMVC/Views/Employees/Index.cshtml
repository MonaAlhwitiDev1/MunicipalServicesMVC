@model IEnumerable<MunicipalServicesMVC.Application.DTOs.EmployeeDto>

@{
    ViewData["Title"] = "الموظفين";

    var employees = Model?.ToList()
        ?? new List<MunicipalServicesMVC.Application.DTOs.EmployeeDto>();

    var employeeImages =
        ViewBag.EmployeeImages as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة وزر الإضافة -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-2"
                style="color:var(--main-green-dark);">
                إدارة الموظفين
            </h2>

            <p class="text-muted mb-0">
                عرض الموظفين المسجلين وإدارة بياناتهم وملفاتهم
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-warning px-4 py-2">
            + إضافة موظف جديد
        </a>

    </div>

    <!-- بطاقة إجمالي الموظفين -->
    <div class="row mb-4">

        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex justify-content-between align-items-center p-4">

                    <div>
                        <p class="text-muted mb-2">
                            إجمالي الموظفين
                        </p>

                        <h2 class="fw-bold mb-0"
                            style="color:var(--main-green);">
                            @employees.Count
                        </h2>
                    </div>

                    <div style="
                        width:60px;
                        height:60px;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        border-radius:15px;
                        background:var(--main-green-light);
                        font-size:28px;">
                        👥
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- جدول الموظفين -->
    <div class="card border-0 shadow-sm">

        <!-- عنوان الجدول بدون مربع عدد الموظفين -->
        <div class="card-header bg-success text-white">

            <h5 class="mb-0 fw-bold">
                قائمة الموظفين
            </h5>

        </div>

        <div class="card-body p-3 p-md-4">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle text-center mb-0">

                    <thead>
                        <tr>
                            <th class="bg-success text-white">الصورة</th>
                            <th class="bg-success text-white">الرقم</th>
                            <th class="bg-success text-white">اسم الموظف</th>
                            <th class="bg-success text-white">المسمى الوظيفي</th>
                            <th class="bg-success text-white">الإدارة</th>
                            <th class="bg-success text-white">الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (employees.Any())
                        {
                            @foreach (var employee in employees)
                            {
                                <tr>

                                    <!-- صورة الموظف -->
                                    <td>
                                        @if (employeeImages.TryGetValue(employee.Id, out var imagePath)
                                           && !string.IsNullOrWhiteSpace(imagePath))
                                        {
                                            <img src="@imagePath"
                                                 alt="صورة @employee.Name"
                                                 class="employee-image" />
                                        }
                                        else
                                        {
                                            <div class="employee-placeholder">
                                                👤
                                            </div>
                                        }
                                    </td>

                                    <!-- رقم الموظف -->
                                    <td>
                                        @employee.Id
                                    </td>

                                    <!-- اسم الموظف -->
                                    <td class="fw-bold"
                                        style="color:var(--main-green-dark);">
                                        @employee.Name
                                    </td>

                                    <!-- المسمى الوظيفي -->
                                    <td>
                                        @employee.JobTitle
                                    </td>

                                    <!-- الإدارة -->
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background:var(--main-green-light);color:var(--main-green);">
                                            @employee.DepartmentName
                                        </span>
                                    </td>

                                    <!-- الإجراءات -->
                                    <td>
                                        <div class="d-flex flex-wrap justify-content-center gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@employee.Id"
                                               class="btn btn-warning btn-sm">
                                                تعديل
                                            </a>

                                            <a asp-action="ManageFiles"
                                               asp-route-id="@employee.Id"
                                               class="btn btn-success btn-sm">
                                                الملفات
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@employee.Id"
                                               class="btn btn-danger btn-sm">
                                                حذف
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-muted py-5">
                                    لا يوجد موظفون مسجلون حاليًا
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>