@model MunicipalServicesMVC.Domain.Models.EmployeeFile

@{
    ViewData["Title"] = "إدارة ملفات الموظف";

    var employeeFiles =
        ViewBag.EmployeeFiles as IEnumerable<MunicipalServicesMVC.Domain.Models.EmployeeFile>;
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="mb-4">
        <h2 class="fw-bold mb-0"
            style="color:var(--main-green-dark);">
            إدارة ملفات الموظف
        </h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">

            <!-- بطاقة رفع الملفات -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-success text-white py-3">
                    <h5 class="fw-bold mb-0">
                        رفع ملفات الموظف
                    </h5>
                </div>

                <div class="card-body p-4">

                    <!-- اسم الموظف -->
                    <div class="mb-4 p-3 rounded-3"
                         style="background:var(--main-green-light);">

                        <span class="fw-bold"
                              style="color:var(--main-green-dark);">
                            اسم الموظف:
                        </span>

                        <span style="color:var(--main-green);">
                            @ViewBag.EmployeeName
                        </span>

                    </div>

                    <!-- رسائل الأخطاء -->
                    @if (TempData["FileError"] != null)
                    {
                        <div class="alert alert-danger mb-4">
                            @TempData["FileError"]
                        </div>
                    }

                    <!-- نموذج رفع الملفات -->
                    <form asp-action="ManageFiles"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="EmployeeId" />

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                اختر الملفات
                            </label>

                            <input type="file"
                                   name="fileEmployees"
                                   class="form-control"
                                   multiple />

                        </div>

                        <!-- أزرار العمليات -->
                        <div class="d-flex flex-wrap justify-content-end gap-2 pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-warning px-4">
                                رجوع
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">
                                رفع الملفات
                            </button>

                        </div>

                    </form>

                </div>
            </div>

            <!-- بطاقة الملفات المرفوعة -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-success text-white py-3">
                    <h5 class="fw-bold mb-0">
                        الملفات المرفوعة
                    </h5>
                </div>

                <div class="card-body p-3 p-md-4">

                    @if (employeeFiles != null && employeeFiles.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-striped table-hover align-middle text-center mb-0">

                                <thead>
                                    <tr>
                                        <th class="bg-success text-white">
                                            اسم الملف
                                        </th>

                                        <th class="bg-success text-white">
                                            معاينة
                                        </th>

                                        <th class="bg-success text-white">
                                            الإجراءات
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var file in employeeFiles)
                                    {
                                        <tr>

                                            <!-- اسم الملف -->
                                            <td class="fw-bold"
                                                style="color:var(--main-green-dark);">
                                                @file.Name
                                            </td>

                                            <!-- معاينة الملف -->
                                            <td>

                                                @if (!string.IsNullOrEmpty(file.FileURL))
                                                {
                                                    <img src="@file.FileURL"
                                                         alt="معاينة الملف"
                                                         style="width:80px;
                                                                height:80px;
                                                                object-fit:cover;
                                                                border-radius:10px;" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        لا توجد معاينة
                                                    </span>
                                                }

                                            </td>

                                            <!-- حذف الملف -->
                                            <td>

                                                <form asp-action="DeleteFile"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@file.Id" />

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm px-3"
                                                            onclick="return confirm('هل أنت متأكد من حذف الملف؟');">
                                                        حذف
                                                    </button>

                                                </form>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">

                            <div class="mb-3"
                                 style="font-size:36px;">
                                📁
                            </div>

                            <p class="text-muted mb-0">
                                لا توجد ملفات مرفوعة لهذا الموظف.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>
    </div>

</div>