@model IEnumerable<MunicipalServicesMVC.Domain.Models.Service>

@{
    ViewData["Title"] = "الخدمات";

    var servicesCount = Model?.Count() ?? 0;
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-2"
                style="color:var(--main-green-dark);">
                إدارة الخدمات
            </h2>

            <p class="text-muted mb-0">
                عرض وإدارة الخدمات المسجلة في النظام
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-warning px-4">
            + إضافة خدمة جديدة
        </a>

    </div>

    <!-- بطاقة عدد الخدمات -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center justify-content-between">

                <div>
                    <h6 class="text-muted mb-2">
                        إجمالي الخدمات
                    </h6>

                    <h3 class="fw-bold mb-0"
                        style="color:var(--main-green-dark);">
                        @servicesCount
                    </h3>
                </div>

                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:55px;
                            height:55px;
                            background-color:#e8f3ed;
                            font-size:26px;">
                    📋
                </div>

            </div>

        </div>

    </div>

    <!-- بطاقة قائمة الخدمات -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-success text-white py-3">

            <h5 class="fw-bold mb-0">
                قائمة الخدمات
            </h5>

        </div>

        <div class="card-body p-3 p-md-4">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle text-center mb-0">

                        <thead>
                            <tr>
                                <th class="bg-success text-white">
                                    الرقم
                                </th>

                                <th class="bg-success text-white">
                                    اسم الخدمة
                                </th>

                                <th class="bg-success text-white">
                                    الوصف
                                </th>

                                <th class="bg-success text-white">
                                    الإدارة
                                </th>

                                <th class="bg-success text-white">
                                    الإجراءات
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var service in Model)
                            {
                                <tr>

                                    <td>
                                        @service.Id
                                    </td>

                                    <td class="fw-bold"
                                        style="color:var(--main-green-dark);">
                                        @service.Name
                                    </td>

                                    <td>
                                        @service.Description
                                    </td>

                                    <td>
                                        @service.Department?.Name
                                    </td>

                                    <td>

                                        <div class="d-flex flex-wrap justify-content-center gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@service.Id"
                                               class="btn btn-warning btn-sm px-3">
                                                تعديل
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@service.Id"
                                               class="btn btn-danger btn-sm px-3">
                                                حذف
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3" style="font-size:36px;">
                        📋
                    </div>

                    <h5 class="fw-bold mb-2">
                        لا توجد خدمات مسجلة
                    </h5>

                    <p class="text-muted mb-0">
                        يمكنك البدء بإضافة خدمة جديدة إلى النظام.
                    </p>

                </div>
            }

        </div>

    </div>

</div>