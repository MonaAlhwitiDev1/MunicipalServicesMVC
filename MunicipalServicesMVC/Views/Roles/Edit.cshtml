@model MunicipalServicesMVC.Domain.Models.Role

@{
    ViewData["Title"] = "تعديل الدور";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="mb-4">
        <h2 class="fw-bold mb-0"
            style="color:var(--main-green-dark);">
            تعديل الدور
        </h2>
    </div>

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9 col-md-11">

            <div class="card border-0 shadow-sm">

                <!-- عنوان البطاقة -->
                <div class="card-header bg-success text-white py-3">
                    <h5 class="fw-bold mb-0">
                        بيانات الدور
                    </h5>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        @Html.AntiForgeryToken()

                        <!-- رقم الدور -->
                        <input type="hidden" asp-for="Id" />

                        <!-- رسائل التحقق -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- اسم الدور -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-bold">
                                اسم الدور
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="أدخل اسم الدور" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- وصف الدور -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-bold">
                                وصف الدور
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="أدخل وصف الدور"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- أزرار الإجراءات -->
                        <div class="d-flex flex-wrap justify-content-end gap-2 pt-3 border-top">

                            <!-- زر الرجوع -->
                            <a asp-action="Index"
                               class="btn btn-warning px-4">
                                رجوع
                            </a>

                            <!-- زر حفظ التعديلات -->
                            <button type="submit"
                                    class="btn btn-success px-4">
                                حفظ التعديلات
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}