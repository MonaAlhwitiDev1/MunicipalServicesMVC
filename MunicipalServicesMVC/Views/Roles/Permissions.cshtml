@model MunicipalServicesMVC.Models.RolePermissionsViewModel

@{
    ViewData["Title"] = "صلاحيات الدور";
}

<div class="container-fluid py-4" dir="rtl">

    <!-- عنوان الصفحة -->
    <div class="mb-4">
        <h2 class="fw-bold mb-0"
            style="color:var(--main-green-dark);">
            صلاحيات الدور
        </h2>
    </div>

    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10 col-md-12">

            <div class="card border-0 shadow-sm">

                <!-- عنوان البطاقة -->
                <div class="card-header bg-success text-white py-3">
                    <h5 class="fw-bold mb-0">
                        إدارة صلاحيات الدور
                    </h5>
                </div>

                <div class="card-body p-4">

                    <!-- اسم الدور -->
                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            اسم الدور
                        </label>

                        <input type="text"
                               value="@Model.RoleName"
                               class="form-control"
                               readonly />

                    </div>

                    <form asp-action="Permissions" method="post">

                        @Html.AntiForgeryToken()

                        <!-- رقم الدور -->
                        <input type="hidden"
                               asp-for="RoleId" />

                        <!-- عنوان الصلاحيات -->
                        <h5 class="fw-bold mb-3"
                            style="color:var(--main-green-dark);">
                            اختر الصلاحيات
                        </h5>

                        <!-- قائمة الصلاحيات -->
                        <div class="border rounded p-3 mb-4">

                            @foreach (var permission in Model.Permissions)
                            {
                                <div class="form-check mb-3 pb-3 border-bottom"
                                     style="padding-right:1.8rem; padding-left:0;">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedPermissionIds"
                                           value="@permission.Id"
                                           id="permission-@permission.Id"
                                           style="float:right; margin-right:-1.8rem; margin-left:0;"
                                           checked="@(Model.SelectedPermissionIds.Contains(permission.Id))" />

                                    <label class="form-check-label"
                                           for="permission-@permission.Id">

                                        <strong>
                                            @permission.Name
                                        </strong>

                                        @if (!string.IsNullOrEmpty(permission.Description))
                                        {
                                            <span class="text-muted d-block mt-1">
                                                @permission.Description
                                            </span>
                                        }

                                    </label>

                                </div>
                            }

                        </div>

                        <!-- أزرار العمليات -->
                        <div class="d-flex flex-wrap justify-content-end gap-2 pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-warning px-4">
                                رجوع
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">
                                حفظ الصلاحيات
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>