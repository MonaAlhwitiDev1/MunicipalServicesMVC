@model IEnumerable<MunicipalServicesMVC.Domain.Models.Role>

    @{
        ViewData["Title"] = "الأدوار";

        var rolesCount = Model == null ? 0 : System.Linq.Enumerable.Count(Model);
    }

    <div class="container-fluid py-4" dir="rtl">

        <!-- عنوان الصفحة وزر الإضافة -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

            <h2 class="fw-bold mb-0"
                style="color:var(--main-green-dark);">
                إدارة الأدوار
            </h2>

            <a asp-action="Create"
               class="btn btn-warning px-4">
                + إضافة دور جديد
            </a>

        </div>

        <!-- بطاقة إجمالي الأدوار -->
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body p-4">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <h6 class="text-muted mb-2">
                            إجمالي الأدوار
                        </h6>

                        <h3 class="fw-bold mb-0"
                            style="color:var(--main-green-dark);">
                            @rolesCount
                        </h3>
                    </div>

                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:55px;
                            height:55px;
                            background-color:#e8f3ed;
                            font-size:26px;">
                        🔐
                    </div>

                </div>

            </div>

        </div>

        <!-- بطاقة قائمة الأدوار -->
        <div class="card border-0 shadow-sm">

            <!-- عنوان البطاقة -->
            <div class="card-header bg-success text-white py-3">

                <h5 class="fw-bold mb-0">
                    قائمة الأدوار
                </h5>

            </div>

            <div class="card-body p-3 p-md-4">

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle text-center mb-0">

                            <thead>
                                <tr>
                                    <th class="bg-success text-white">
                                        الرقم
                                    </th>

                                    <th class="bg-success text-white">
                                        اسم الدور
                                    </th>

                                    <th class="bg-success text-white">
                                        الوصف
                                    </th>

                                    <th class="bg-success text-white">
                                        الإجراءات
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <!-- الرقم -->
                                        <td>
                                            @item.Id
                                        </td>

                                        <!-- اسم الدور -->
                                        <td class="fw-bold"
                                            style="color:var(--main-green-dark);">
                                            @item.Name
                                        </td>

                                        <!-- الوصف -->
                                        <td>
                                            @item.Description
                                        </td>

                                        <!-- الإجراءات -->
                                        <td>

                                            <div class="d-flex flex-wrap justify-content-center gap-2">

                                                <!-- إدارة الصلاحيات -->
                                                <a asp-action="Permissions"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-success btn-sm px-3">
                                                    الصلاحيات
                                                </a>

                                                <!-- تعديل الدور -->
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-warning btn-sm px-3">
                                                    تعديل
                                                </a>

                                                <!-- حذف الدور -->
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-danger btn-sm px-3">
                                                    حذف
                                                </a>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <!-- عند عدم وجود أدوار -->
                    <div class="text-center py-5">

                        <div class="mb-3"
                             style="font-size:36px;">
                            🔐
                        </div>

                        <h5 class="fw-bold mb-2">
                            لا توجد أدوار مسجلة
                        </h5>

                        <p class="text-muted mb-0">
                            يمكنك إضافة دور جديد إلى النظام.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>
